@page "/checkout"
@using KiWish.Services
@inject StripeService StripeService
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration

<PageTitle>Checkout - KiWish</PageTitle>

<div class="bg-cream min-h-screen py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
            <h1 class="font-serif text-4xl font-bold text-kiwi-900 mb-4">Complete Your Order</h1>
            <p class="text-stone-600">Secure checkout powered by Stripe</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Order Summary -->
            <div class="bg-white rounded-2xl shadow-sm border border-stone-200 p-6">
                <h2 class="text-xl font-bold text-stone-900 mb-6">Order Summary</h2>
                
                <div class="flex items-center gap-4 mb-6">
                    <img src="ProductImage.jpeg" alt="KiWish Product" class="w-20 h-20 object-cover rounded-lg">
                    <div>
                        <h3 class="font-medium text-stone-900">KiWish Detox</h3>
                        <p class="text-stone-600 text-sm">Stubborn Fat Reduction Formula</p>
                        <p class="text-kiwi-600 font-semibold">USD $49.99</p>
                    </div>
                </div>

                <div class="border-t border-stone-100 pt-4 mt-4">
                    <div class="flex justify-between mb-2">
                        <span class="text-stone-600">Quantity</span>
                        <span class="text-stone-900">@Quantity</span>
                    </div>
                    <div class="flex justify-between mb-2">
                        <span class="text-stone-600">Subtotal</span>
                        <span class="text-stone-900">$@Subtotal.ToString("F2")</span>
                    </div>
                    <div class="flex justify-between mb-2">
                        <span class="text-stone-600">Shipping</span>
                        <span class="text-stone-900">$@Shipping.ToString("F2")</span>
                    </div>
                    <div class="flex justify-between mt-4 pt-4 border-t border-stone-100 font-bold text-lg">
                        <span>Total</span>
                        <span class="text-kiwi-600">$@Total.ToString("F2")</span>
                    </div>
                </div>
            </div>

            <!-- Payment Form -->
            <div class="bg-white rounded-2xl shadow-sm border border-stone-200 p-6">
                <h2 class="text-xl font-bold text-stone-900 mb-6">Payment Information</h2>
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-stone-700 mb-1">Full Name</label>
                        <input type="text" @bind="CustomerName" class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:ring-2 focus:ring-kiwi-500 focus:border-kiwi-500" placeholder="John Doe" />
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-stone-700 mb-1">Email</label>
                        <input type="email" @bind="CustomerEmail" class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:ring-2 focus:ring-kiwi-500 focus:border-kiwi-500" placeholder="john@example.com" />
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-stone-700 mb-1">Quantity</label>
                        <select @bind="Quantity" class="w-full px-4 py-3 border border-stone-300 rounded-lg focus:ring-2 focus:ring-kiwi-500 focus:border-kiwi-500">
                            @for (int i = 1; i <= 10; i++)
                            {
                                <option value="@i">@i @(i == 1 ? "bottle" : "bottles")</option>
                            }
                        </select>
                    </div>
                    
                    <div class="pt-4">
                        <button @onclick="ProcessPayment" disabled="@IsProcessing" class="w-full bg-kiwi-600 text-white py-4 rounded-full font-medium shadow-lg shadow-kiwi-600/30 hover:bg-kiwi-700 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 @(IsProcessing ? "opacity-70 cursor-not-allowed" : "")">
                            @(IsProcessing ? "Processing..." : $"Pay ${Total.ToString("F2")}")
                        </button>
                        <p class="text-center text-xs text-stone-500 mt-3">Secure payment powered by Stripe</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string CustomerName = "";
    private string CustomerEmail = "";
    private int Quantity = 1;
    private bool IsProcessing = false;
    
    private decimal UnitPrice = 49.99m;
    private decimal Shipping = 5.99m;
    
    private decimal Subtotal => UnitPrice * Quantity;
    private decimal Total => Subtotal + Shipping;

    private async Task ProcessPayment()
    {
        if (string.IsNullOrWhiteSpace(CustomerName) || string.IsNullOrWhiteSpace(CustomerEmail))
        {
            // In a real app, you would show validation errors
            return;
        }

        IsProcessing = true;
        
        try
        {
            var successUrl = NavigationManager.BaseUri + "checkout/success?session_id={CHECKOUT_SESSION_ID}";
            var cancelUrl = NavigationManager.BaseUri + "checkout";
            
            var checkoutUrl = await StripeService.CreateCheckoutSessionForKiWishProductAsync(
                successUrl, 
                cancelUrl, 
                Quantity, 
                UnitPrice
            );
            
            // Redirect to Stripe checkout
            NavigationManager.NavigateTo(checkoutUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            // In a real app, you would handle the error properly
            IsProcessing = false;
            // You might want to show an error message to the user
            Console.WriteLine($"Error processing payment: {ex.Message}");
        }
    }
}