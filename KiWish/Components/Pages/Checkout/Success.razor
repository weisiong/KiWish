@page "/checkout/success"
@using KiWish.Services
@inject NavigationManager NavigationManager
@inject StripeService StripeService

<PageTitle>Order Successful - KiWish</PageTitle>

<div class="bg-cream min-h-screen py-12">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
            <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-kiwi-100">
                <svg class="h-10 w-10 text-kiwi-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
            </div>
            <h1 class="mt-6 text-3xl font-bold text-kiwi-900">Thank You for Your Order!</h1>
            <p class="mt-4 text-stone-600">Your payment has been processed successfully.</p>
            
            <div class="mt-10 bg-white rounded-2xl shadow-sm border border-stone-200 p-6 text-left">
                <h2 class="text-xl font-bold text-stone-900 mb-4">Order Details</h2>
                
                <div class="space-y-3">
                    <div class="flex justify-between">
                        <span class="text-stone-600">Product:</span>
                        <span class="text-stone-900">KiWish Detox</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-stone-600">Quantity:</span>
                        <span class="text-stone-900">@Quantity bottles</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-stone-600">Total:</span>
                        <span class="text-kiwi-600 font-semibold">$@Total</span>
                    </div>
                </div>
                
                <div class="mt-8 p-4 bg-kiwi-50 rounded-lg border border-kiwi-100">
                    <h3 class="font-medium text-kiwi-800 flex items-center gap-2">
                        <svg class="w-5 h-5 text-kiwi-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Next Steps
                    </h3>
                    <p class="mt-2 text-sm text-kiwi-700">
                        You will receive an email confirmation shortly with order details and shipping information. 
                        Your KiWish product will be shipped within 2-3 business days.
                    </p>
                </div>
            </div>
            
            <div class="mt-8">
                <button @onclick="GoHome" class="bg-kiwi-600 text-white px-8 py-3 rounded-full font-medium hover:bg-kiwi-700 transition-colors">
                    Continue Shopping
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "session_id")]
    public string? SessionId { get; set; }

    private int Quantity = 1;
    private string Total = "55.98";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(SessionId))
        {
            try
            {
                var session = await StripeService.GetCheckoutSessionAsync(SessionId);
                
                if (session != null)
                {
                    if (session.Metadata != null && session.Metadata.TryGetValue("quantity", out var quantityStr))
                    {
                        if (int.TryParse(quantityStr, out var q))
                        {
                            Quantity = q;
                        }
                    }

                    if (session.AmountTotal.HasValue)
                    {
                        Total = (session.AmountTotal.Value / 100m).ToString("F2");
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error fetching session: {ex.Message}");
            }
        }
    }

    private void GoHome()
    {
        NavigationManager.NavigateTo("/");
    }
}